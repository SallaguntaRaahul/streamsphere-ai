# Non-secret local defaults. Copy to .env to override. Never commit real secrets.
COMPOSE_PROJECT_NAME=streamsphere
POSTGRES_SUPERUSER_PASSWORD=local-superuser-pw
RABBITMQ_USER=streamsphere
RABBITMQ_PASSWORD=local-rabbit-pw
MINIO_ROOT_USER=streamsphere
MINIO_ROOT_PASSWORD=local-minio-pw-123
KEYCLOAK_ADMIN_PASSWORD=local-kc-admin-pw
# HMAC key for playback tokens (local only; generate with: openssl rand -hex 32)
PLAYBACK_TOKEN_SECRET=local-dev-playback-secret-change-me-0123456789abcdef
# Cost guard (application-side estimate, NOT a billing cap)
STORAGE_QUOTA_BYTES=8000000000
COST_GUARD_STOP_RATIO=0.95
MAX_UPLOAD_BYTES=2147483648
# Paid adapters stay off unless the owner explicitly approves spend
PAID_PROVIDERS_ENABLED=false
# shared secret between tusd and the upload service hook endpoint (local value)
TUS_HOOK_SECRET=local-tus-hook-secret-0123456789
ANALYTICS_USER_HASH_SALT=local-dev-salt-change-me
