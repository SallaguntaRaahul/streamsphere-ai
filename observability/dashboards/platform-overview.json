{
 "uid": "streamsphere-overview",
 "title": "StreamSphere \u2014 Platform overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "streamsphere"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / s by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_server_requests_seconds_count[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "5xx ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Playback authorization p50/p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(streamsphere_playback_authorization_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "HLS startup (client beacons) p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    }
   },
   "targets": [
    {
     "expr": "streamsphere_hls_startup_ms{quantile=\"0.95\"}",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Events consumed / retried / DLQ",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    }
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(streamsphere_events_consumed_total[5m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Transcode queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "rabbitmq_queue_messages_ready{queue=\"ffmpeg-worker.requests\"}",
     "legendFormat": "ready",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "gauge",
   "title": "Cost guard: storage estimate vs quota",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "streamsphere_cost_quota_ratio",
     "legendFormat": "ratio",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(streamsphere_cache_requests_total{result=\"hit\"}[5m])) / sum(rate(streamsphere_cache_requests_total[5m]))",
     "legendFormat": "hit",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "DB pool active connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (hikaricp_connections_active)",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "JVM heap used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Recommendation latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(streamsphere_recommendation_latency_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  }
 ]
}