<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>ai.streamsphere</groupId>
  <artifactId>streamsphere-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>StreamSphere AI</name>
  <description>Creator-first video-on-demand streaming platform (microservices)</description>
  <developers>
    <developer>
      <name>Raahul Sallagunta</name>
      <roles><role>author</role><role>maintainer</role></roles>
    </developer>
  </developers>
  <licenses>
    <license><name>MIT</name><url>https://opensource.org/license/mit</url></license>
  </licenses>

  <modules>
    <module>packages/technical-common</module>
    <module>services/gateway</module>
    <module>services/profile</module>
    <module>services/catalog</module>
    <module>services/creator</module>
    <module>services/upload</module>
    <module>services/media</module>
    <module>services/playback</module>
    <module>services/history</module>
    <module>services/search</module>
    <module>services/moderation</module>
    <module>services/analytics</module>
    <module>services/notifications</module>
    <module>workers/ffmpeg</module>
  </modules>

  <properties>
    <test.excludedGroups></test.excludedGroups>
    <java.version>21</java.version>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <awssdk.version>2.57.3</awssdk.version>
    <fabric8.version>7.9.0</fabric8.version>
    <springdoc.version>3.0.3</springdoc.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.fabric8</groupId>
        <artifactId>kubernetes-client-bom</artifactId>
        <version>${fabric8.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>ai.streamsphere</groupId>
        <artifactId>technical-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <layers><enabled>true</enabled></layers>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>${test.excludedGroups}</excludedGroups>
            <!-- keep Testcontainers' ~/.testcontainers.properties inside the repo (owner preference) -->
            <systemPropertyVariables>
              <user.home>${maven.multiModuleProjectDirectory}/tmp/test-home</user.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Docker Desktop on macOS: the socket lives under the real home, which Testcontainers can't see once
         user.home is redirected into the repo (see surefire config) -->
    <profile>
      <id>docker-desktop-mac</id>
      <activation><os><family>mac</family></os></activation>
      <build><pluginManagement><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><environmentVariables><DOCKER_HOST>unix://${env.HOME}/.docker/run/docker.sock</DOCKER_HOST><TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE></environmentVariables></configuration>
      </plugin></plugins></pluginManagement></build>
    </profile>
    <!-- mvn -Pfast skips Testcontainers ("integration") tests -->
    <profile>
      <id>fast</id>
      <properties><test.excludedGroups>integration</test.excludedGroups></properties>
    </profile>
  </profiles>
</project>
