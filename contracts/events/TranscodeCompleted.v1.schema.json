   "type": "string",
   "format": "uuid"
  },
  "assetId": {
   "type": "string",
   "format": "uuid"
  },
  "outputPrefix": {
   "type": "string"
  },
  "durationSeconds": {
   "type": "integer"
  },
  "width": {
   "type": "integer"
  },
  "height": {
   "type": "integer"
  },
  "hasAudio": {
   "type": "boolean"
  },
  "renditions": {
   "type": "array"
  },
  "posterKey": {
   "type": [
    "string",
    "null"
   ]
  },
  "thumbnailCount": {
   "type": "integer"
  },
  "totalBytes": {
   "type": "integer"
  },
  "wallSeconds": {
   "type": "number"
  },
  "cpuSeconds": {
   "type": "number"
  },
  "ffmpegVersion": {
   "type": "string"
  }
 }
}