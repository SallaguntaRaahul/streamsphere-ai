    "@angular/router": "^22.2.0",
    "hls.js": "^1.7.3",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
